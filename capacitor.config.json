{
  "appId": "com.madaratn.novelreader",
  "appName": "NovelReader",
  "webDir": "dist-android",
  "server": {
    "androidScheme": "https"
  },
  "android": {
    "allowMixedContent": true,
    "webContentsDebuggingEnabled": true
  },
  "plugins": {
    "CapacitorHttp": {
      "enabled": true
    }
  },
  "loggingBehavior": "production",
  "ios": {
    "contentInset": "always",
    "allowsLinkPreview": false,
    "scrollEnabled": true
  }
}
