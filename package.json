{
  "name": "novel-reader-windows",
  "version": "0.3.0",
  "private": true,
  "description": "NovelReader for Windows",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "electron": "electron .",
    "start": "concurrently \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "dist": "npm run prepare:anime-engine && npm run build && electron-builder --win nsis --publish never",
    "dist:portable": "npm run prepare:anime-engine && npm run build && electron-builder --win portable --publish never",
    "prepare:anime-engine": "node scripts/prepare-miwayomi.cjs",
    "anime:engine:info": "node -e \"console.log(require('./engine/miwayomi-version.json'))\"",
    "test:torrent": "node scripts/test-archive-torrent.mjs",
    "test:ui": "playwright test",
    "release": "npm run prepare:anime-engine && npm run build && electron-builder --win nsis --publish always",
    "test:unit": "node --test \"tests/unit/*.test.cjs\"",
    "check:i18n": "node scripts/check-i18n.cjs",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "cheerio": "^1.1.2",
    "dayjs": "^1.11.13",
    "electron-updater": "^6.8.10",
    "htmlparser2": "^10.0.0",
    "jszip": "^3.10.1",
    "urlencode": "^2.0.0",
    "webtorrent": "~2.8.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "^34.0.0",
    "electron-builder": "^26.0.12",
    "extract-zip": "^2.0.1",
    "hls.js": "^1.6.13",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "wait-on": "^8.0.2"
  },
  "overrides": {
    "uint8-util": "2.2.6"
  },
  "author": "Ali Mezghenni",
  "build": {
    "appId": "com.novelreader.windows",
    "productName": "NovelReader",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "NovelReader-Setup-${version}.${ext}",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "NovelReader",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "extraResources": [
      {
        "from": "engine",
        "to": "engine",
        "filter": [
          "**/*"
        ]
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "madaratn",
        "repo": "NovelReader-Windows",
        "releaseType": "release"
      }
    ]
  }
}
