{
  "name": "novel-reader-windows",
  "version": "0.2.0",
  "private": true,
  "description": "NovelReader for Windows",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "electron": "electron .",
    "start": "concurrently \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "dist": "npm run prepare:anime-engine && npm run build && electron-builder --win nsis",
    "dist:portable": "npm run prepare:anime-engine && npm run build && electron-builder --win portable",
    "prepare:anime-engine": "node scripts/prepare-miwayomi.cjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^6.0.7",
    "typescript": "^5.7.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "cheerio": "^1.1.2",
    "dayjs": "^1.11.13",
    "htmlparser2": "^10.0.0",
    "urlencode": "^2.0.0"
  },
  "devDependencies": {
    "electron": "^34.0.0",
    "concurrently": "^9.1.2",
    "wait-on": "^8.0.2",
    "electron-builder": "^26.0.12",
    "extract-zip": "^2.0.1"
  },
  "author": "Ali Mezghenni",
  "build": {
    "appId": "com.novelreader.windows",
    "productName": "NovelReader",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "NovelReader-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "NovelReader"
    },
    "extraResources": [
      {
        "from": "engine",
        "to": "engine",
        "filter": [
          "**/*"
        ]
      }
    ]
  }
}
