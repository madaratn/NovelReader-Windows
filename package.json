{
  "name": "novel-reader-windows",
  "version": "0.1.0",
  "private": true,
  "description": "Windows novel reader prototype with extensible sources",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "electron": "electron .",
    "start": "concurrently \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\""
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^6.0.7",
    "typescript": "^5.7.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "electron": "^34.0.0",
    "concurrently": "^9.1.2",
    "wait-on": "^8.0.2"
  }
}