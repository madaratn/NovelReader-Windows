{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": [],
    // Tolerant to start with: catches typos, wrong props and missing
    // imports without forcing types on existing `any`-heavy code.
    "strict": false,
    "noImplicitAny": false
  },
  "include": ["src"]
}
